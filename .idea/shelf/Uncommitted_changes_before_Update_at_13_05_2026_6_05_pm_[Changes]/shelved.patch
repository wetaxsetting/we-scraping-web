<+>@import \"tailwindcss\";\r\n@import \"../node_modules/tw-animate-css/dist/tw-animate.css\";\r\n\r\n@custom-variant dark (&:is(.dark *));\r\n\r\n/* shadcn/ui semantic tokens — light theme */\r\n:root {\r\n    --radius: 0.625rem;\r\n    --background: oklch(1 0 0);\r\n    --foreground: oklch(0.145 0 0);\r\n    --card: oklch(1 0 0);\r\n    --card-foreground: oklch(0.145 0 0);\r\n    --popover: oklch(1 0 0);\r\n    --popover-foreground: oklch(0.145 0 0);\r\n    --primary: oklch(0.205 0 0);\r\n    --primary-foreground: oklch(0.985 0 0);\r\n    --secondary: oklch(0.97 0 0);\r\n    --secondary-foreground: oklch(0.205 0 0);\r\n    --muted: oklch(0.97 0 0);\r\n    --muted-foreground: oklch(0.556 0 0);\r\n    --accent: oklch(0.97 0 0);\r\n    --accent-foreground: oklch(0.205 0 0);\r\n    --destructive: oklch(0.577 0.245 27.325);\r\n    --destructive-foreground: oklch(0.985 0 0);\r\n    --border: oklch(0.922 0 0);\r\n    --input: oklch(0.922 0 0);\r\n    --ring: oklch(0.708 0 0);\r\n}\r\n\r\n.dark {\r\n    --background: oklch(0.145 0 0);\r\n    --foreground: oklch(0.985 0 0);\r\n    --card: oklch(0.205 0 0);\r\n    --card-foreground: oklch(0.985 0 0);\r\n    --popover: oklch(0.205 0 0);\r\n    --popover-foreground: oklch(0.985 0 0);\r\n    --primary: oklch(0.922 0 0);\r\n    --primary-foreground: oklch(0.205 0 0);\r\n    --secondary: oklch(0.269 0 0);\r\n    --secondary-foreground: oklch(0.985 0 0);\r\n    --muted: oklch(0.269 0 0);\r\n    --muted-foreground: oklch(0.708 0 0);\r\n    --accent: oklch(0.269 0 0);\r\n    --accent-foreground: oklch(0.985 0 0);\r\n    --destructive: oklch(0.704 0.191 22.216);\r\n    --destructive-foreground: oklch(0.985 0 0);\r\n    --border: oklch(1 0 0 / 10%);\r\n    --input: oklch(1 0 0 / 15%);\r\n    --ring: oklch(0.556 0 0);\r\n}\r\n\r\n/* WeCMS + shadcn design tokens (surface as Tailwind utilities) */\r\n@theme inline {\r\n    /* Responsive breakpoints — WeCMS contract.\r\n       Mobile  : < 768  (default, no prefix)\r\n       Tablet  : 768 – 1023  (md:)\r\n       Laptop  : 1024 – 1439 (lg:)\r\n       Desktop : ≥ 1440      (2xl:)\r\n       The 2xl override drops Tailwind's default 1536 → 1440 so the\r\n       prefix lines up with the Figma Desktop frame (199:6973, ≥1440).\r\n       xl: (1280) is intentionally left at its default but reserved —\r\n       avoid using it in WeCMS UI; the 4-tier mapping above is the\r\n       sanctioned breakpoint set per the app's responsive spec. */\r\n    --breakpoint-2xl: 1440px;\r\n\r\n    --color-background: var(--background);\r\n    --color-foreground: var(--foreground);\r\n    --color-card: var(--card);\r\n    --color-card-foreground: var(--card-foreground);\r\n    --color-popover: var(--popover);\r\n    --color-popover-foreground: var(--popover-foreground);\r\n    --color-primary: var(--primary);\r\n    --color-primary-foreground: var(--primary-foreground);\r\n    --color-secondary: var(--secondary);\r\n    --color-secondary-foreground: var(--secondary-foreground);\r\n    --color-muted: var(--muted);\r\n    --color-muted-foreground: var(--muted-foreground);\r\n    --color-accent: var(--accent);\r\n    --color-accent-foreground: var(--accent-foreground);\r\n    --color-destructive: var(--destructive);\r\n    --color-destructive-foreground: var(--destructive-foreground);\r\n    --color-border: var(--border);\r\n    --color-input: var(--input);\r\n    --color-ring: var(--ring);\r\n\r\n    --radius-sm: calc(var(--radius) - 4px);\r\n    --radius-md: calc(var(--radius) - 2px);\r\n    --radius-lg: var(--radius);\r\n    --radius-xl: calc(var(--radius) + 4px);\r\n\r\n    /* WeCMS brand tokens */\r\n    --color-brand: #0060b9;           /* WB365 Blue-06 — header, primary CTA */\r\n    --color-brand-hover: #0152a3;     /* WB365 Blue-07 */\r\n    --color-brand-active: #0069b9;    /* active-tab text on white bg */\r\n    --color-brand-soft: #f0f7ff;      /* WB365 Prime-01 — login bg */\r\n    --color-brand-softer: rgba(0, 96, 185, 0.15); /* \"4 Accounts\" pill bg */\r\n\r\n    /* WeCMS semantic neutrals (from Figma WB365 neutral ramp) */\r\n    --color-wb-dark: #05111d;           /* page title */\r\n    --color-wb-ink: #1b1b1b;            /* primary text */\r\n    --color-wb-ntrl-8: #404040;\r\n    --color-wb-ntrl-6: #737373;\r\n    --color-wb-muted: #828282;          /* account number, Last Update */\r\n    --color-wb-ntrl-5: #a3a3a3;         /* placeholder text */\r\n    --color-wb-ntrl-4: #d4d4d4;         /* input / dropdown shadow-border */\r\n    --color-wb-table-border: #d3d3d3;   /* WB365 gray-03 — table row border */\r\n    --color-wb-ntrl-3: #e5e5e5;         /* VND/FCY badge bg */\r\n    --color-wb-bg-active: #e3e3e3;      /* selected sidebar row */\r\n    --color-wb-border-sidebar: #e0e0e0; /* sidebar right border */\r\n    --color-wb-bg-sidebar: #f5f5f5;     /* sidebar + table header bg */\r\n    --color-wb-bg-card: #fbfbfb;        /* summary card bg */\r\n    --color-wb-bg-footer: #fafafa;      /* sticky table footer bg */\r\n\r\n    /* WeCMS semantic status */\r\n    --color-wb-error: #f65f19;          /* WB365 secondary-06 — \"Error\" text */\r\n    --color-wb-warning: #f5bb1e;        /* WB365 gold-06 — icon accent */\r\n    --color-wb-navy: #0b3c6f;           /* WB365 navy — login marketing band */\r\n\r\n    /* Approval status palette — Figma WB365 Red/Green/Blue ramps\r\n       (used by StatusBadge in payment/approval-box). */\r\n    --color-wb-status-draft-bg: #f6f6f6;         /* WB365 gray-01 */\r\n    --color-wb-status-draft-text: #7d7d7d;       /* WB365 gray-05 */\r\n    --color-wb-status-pending-bg: #fdfee6;       /* WB365 green-01 */\r\n    --color-wb-status-pending-text: #566400;     /* WB365 green-04 */\r\n    --color-wb-status-progress-bg: #e9efff;      /* WB365 blue-01 */\r\n    --color-wb-status-progress-text: #0f1fea;    /* WB365 blue-08 */\r\n    --color-wb-status-approved-bg: #e9f5ee;      /* WB365 green-00 */\r\n    --color-wb-status-approved-text: #04662e;    /* WB365 green-03 */\r\n    --color-wb-status-rejected-bg: #fce9eb;      /* WB365 red-01 */\r\n    --color-wb-status-rejected-text: #c50712;    /* WB365 red-04 */\r\n\r\n    /* ─────────────────────────────────────────────────────────────\r\n       Fonts — Figma WB365 spec:\r\n       Inter is the primary Latin face (dashboard, numerics),\r\n       Noto Sans KR handles Korean (login/marketing hero).\r\n       Browsers pick Noto Sans KR for Korean codepoints automatically\r\n       via the cascade, even with Inter listed first.\r\n       ───────────────────────────────────────────────────────────── */\r\n    --font-sans: var(--font-inter, \"Inter\"), var(--font-noto-kr, \"Noto Sans KR\"),\r\n                 \"Malgun Gothic\", \"Dotum\", \"Segoe UI\", -apple-system, BlinkMacSystemFont,\r\n                 Arial, sans-serif;\r\n    --font-inter: var(--font-inter, \"Inter\"), -apple-system, BlinkMacSystemFont,\r\n                  \"Segoe UI\", Arial, sans-serif;\r\n\r\n    /* ─────────────────────────────────────────────────────────────\r\n       Typographic scale — Figma WB365 (SOURCE OF TRUTH).\r\n       Usage: text-wb-{size} → font-size + paired line-height.\r\n       Weights used across the system: 500 (Medium), 600 (SemiBold),\r\n       700 (Bold). Regular (400) only where Figma explicitly says so.\r\n       ───────────────────────────────────────────────────────────── */\r\n    --text-wb-10: 10px;                 /* micro pills (VND/FCY, \"4 Accounts\") */\r\n    --text-wb-10--line-height: 16px;\r\n    --text-wb-11: 11px;                 /* sidebar group title (uppercase), caption */\r\n    --text-wb-11--line-height: 16px;\r\n    --text-wb-12: 12px;                 /* TOTAL ACCOUNTS label, bottom-band check items,\r\n                                           secondary metadata */\r\n    --text-wb-12--line-height: 20px;\r\n    --text-wb-13: 13px;                 /* dropdown, sidebar nav item, pagination text,\r\n                                           summary secondary row */\r\n    --text-wb-13--line-height: normal;\r\n    --text-wb-14: 14px;                 /* table cell, table header, filter row, search\r\n                                           input, Dashboard-chip button, tile label */\r\n    --text-wb-14--line-height: 20px;\r\n    --text-wb-14-tight: 14px;           /* tight leading (header row / filter chip: 14/16) */\r\n    --text-wb-14-tight--line-height: 16px;\r\n    --text-wb-14-loose: 14px;           /* loose leading (Last Update cell: 14/28) */\r\n    --text-wb-14-loose--line-height: 28px;\r\n    --text-wb-14-relaxed: 14px;         /* relaxed leading (system dialog body: 14/22) */\r\n    --text-wb-14-relaxed--line-height: 22px;\r\n    --text-wb-15: 15px;                 /* secondary header / menu label when Figma calls */\r\n    --text-wb-15--line-height: normal;\r\n    --text-wb-16: 16px;                 /* summary-card \"Available Balance\" (16/normal) */\r\n    --text-wb-16--line-height: normal;\r\n    --text-wb-18: 18px;                 /* dashboard page title \"Account Inquiry (VND)\",\r\n                                           login form input + button at desktop */\r\n    --text-wb-18--line-height: 28px;\r\n    --text-wb-22: 22px;                 /* hero-title mobile step (login marketing panel) */\r\n    --text-wb-22--line-height: 32px;\r\n    --text-wb-24: 24px;                 /* Figma Save-ID label (login), large section heading */\r\n    --text-wb-24--line-height: 32px;\r\n    --text-wb-28: 28px;                 /* hero-title laptop step (login marketing panel) */\r\n    --text-wb-28--line-height: 40px;\r\n    --text-wb-34: 34px;                 /* login hero title @ desktop (Figma 4728:40157) */\r\n    --text-wb-34--line-height: 48px;\r\n\r\n    /* ─────────────────────────────────────────────────────────────\r\n       Tracking — a few Figma letter-spacings (mostly -0.01 to -0.04em)\r\n       Usage: tracking-wb-{name}\r\n       ───────────────────────────────────────────────────────────── */\r\n    --tracking-wb-tight: -0.01em;\r\n    --tracking-wb-tighter: -0.04em;\r\n\r\n    /* ─────────────────────────────────────────────────────────────\r\n       Shadows — from Figma effect tokens\r\n       \"Default Button/Default\"  →  shadow-wb-btn   (raised button)\r\n       \"Outline/Normal\"          →  shadow-wb-outline (1px outline)\r\n       Focus ring (brand)        →  shadow-wb-focus\r\n       Summary card border       →  shadow-wb-card\r\n       ───────────────────────────────────────────────────────────── */\r\n    --shadow-wb-btn: 0 0 0 1px rgba(0, 0, 0, 0.17), 0 1px 1px 0 rgba(0, 0, 0, 0.15), 0 2px 3px 0 rgba(0, 0, 0, 0.08);\r\n    --shadow-wb-outline: 0 0 0 1px var(--color-wb-ntrl-4);\r\n    --shadow-wb-focus: 0 0 0 2px var(--color-brand);\r\n    --shadow-wb-card: 0 0 0 1px var(--color-wb-border-sidebar);\r\n    /* Balance-click popup (Figma 87:13094) */\r\n    --shadow-wb-popup: 0 0 0.5px rgba(0,0,0,0.22), 0 1px 1px rgba(0,0,0,0.06), 0 4px 10px rgba(0,0,0,0.15);\r\n    /* Login brand button (active press) */\r\n    --shadow-wb-brand-btn: 0 0 0 1px var(--color-brand-hover), 0 1px 1px 0 rgba(0, 96, 185, 0.5), 0 2px 3px 0 rgba(0, 96, 185, 0.1);\r\n    /* Warning / destructive button — Figma \"Warning Button/Default\" (WB365 red-04 ring +\r\n       red-tinted soft drop shadows). Used by the Disconnect button in the Registered\r\n       Login Credentials dialog and by per-row red icon buttons that share the same ramp. */\r\n    --color-wb-red-04: #fea3a8;          /* WB365 red-04 — outlined warning ring */\r\n    --color-wb-red-07: #e1232e;          /* WB365 red-07 — warning button label */\r\n    /* Soft red drop shadow for warning buttons. The 1px outline ring is provided\r\n       separately by `border border-wb-red-04` on the consumer so the visible ring\r\n       always renders, even if Tailwind ever fails to resolve a custom shadow token.\r\n       Hex is inlined (no var() chain) so the value is self-contained. */\r\n    --shadow-wb-warning-btn: 0 1px 1px 0 rgba(236, 0, 42, 0.15), 0 2px 3px 0 rgba(236, 0, 42, 0.1);\r\n\r\n    /* ─────────────────────────────────────────────────────────────\r\n       Layout — fixed component widths from Figma (Account Inquiry VND)\r\n       Usage: w-wb-{name}\r\n       ───────────────────────────────────────────────────────────── */\r\n    --w-wb-sidebar: 211px;              /* left sidebar */\r\n    --w-wb-summary: 308px;              /* summary card */\r\n    --w-wb-summary-h: 118px;\r\n    --w-wb-search: 230px;               /* filter row search input */\r\n    --w-wb-filter-bank: 105px;          /* \"All Banks\" dropdown */\r\n    --w-wb-page-size: 62px;             /* pagination \"10\" dropdown */\r\n    --w-wb-col-checkbox: 38px;          /* table col: checkbox */\r\n    --w-wb-col-bank: 240px;             /* table col: Bank */\r\n    --w-wb-col-nickname: 280px;         /* table col: Account Nickname */\r\n    --w-wb-col-balance: 160px;          /* table col: Balance */\r\n    --w-wb-col-available: 180px;        /* table col: Available Balance */\r\n    --w-wb-col-last-update: 160px;      /* table col: Last Update */\r\n    --w-wb-col-vas-account: 200px;      /* table col: VAS Account (hidden by default in fnsh_0001_001) */\r\n    --w-wb-table-min: 1058px;           /* sum of col widths — trigger horizontal scroll below this */\r\n\r\n    /* Approval Box table (payment/approval-box) — Figma 9184:10579.\r\n       Column widths are sized so every header label (incl. the 18px sort\r\n       icon and 20px horizontal padding) fits on a single line at 13px/600. */\r\n    --w-wb-ap-date: 104px;\r\n    --w-wb-ap-type: 140px;\r\n    --w-wb-ap-docno: 150px;\r\n    --w-wb-ap-title: 260px;\r\n    --w-wb-ap-filename: 240px;\r\n    --w-wb-ap-currency: 160px;\r\n    --w-wb-ap-amount: 160px;\r\n    --w-wb-ap-status: 140px;\r\n    --w-wb-ap-scheduled: 140px;\r\n    --w-wb-ap-requestor: 160px;\r\n    --w-wb-ap-approver: 180px;\r\n    --w-wb-ap-table-min: 1834px;        /* sum of column widths */\r\n\r\n    /* Scheduled Transfer table (payment/internal-transfer) — Figma 1:9972.\r\n       Mirrors the Approval Box scale (60px row, 40px head, 13/600 header).\r\n       Column widths are sized so the live sample row fits without truncation:\r\n       \"Internal_Transfer_241210\", \"45 Transaction (VND)\", \"Lakeside Haven [3] v\",\r\n       \"Approval Status\" header, etc. The Approval Title column is intentionally\r\n       narrow — Figma 1:9972 wraps the title to 2 lines, not single-line truncation. */\r\n    --w-wb-st-checkbox: 38px;\r\n    --w-wb-st-datetime: 100px;\r\n    --w-wb-st-filename: 210px;\r\n    --w-wb-st-txn-count: 180px;\r\n    --w-wb-st-total: 165px;\r\n    --w-wb-st-status: 145px;\r\n    --w-wb-st-requestor: 92px;\r\n    --w-wb-st-approver: 200px;\r\n    --w-wb-st-approval-ref: 150px;\r\n    --w-wb-st-approval-title: 220px;\r\n    --w-wb-st-action: 110px;            /* \"Transfer\" chip + 8px + file icon */\r\n    --w-wb-st-table-min: 1610px;        /* sum of column widths */\r\n    --w-wb-st-schedule-date: 120px;     /* Overseas-only: Schedule Date column (\"28-Dec-2025\") */\r\n    --w-wb-st-table-min-overseas: 1730px; /* Overseas: 11 base cols + 120px Schedule Date */\r\n    --w-wb-st-period: 160px;            /* \"Last 30 Days\" dropdown — calendar icon + label + chevron;\r\n                                           sized for header math: 16 (icon) + 8 (gap) + ~75 (text-13/500\r\n                                           \"Last 30 Days\") + 8 (gap) + 16 (chevron) + 20 (px-2.5 × 2) */\r\n    --w-wb-st-status-filter: 168px;     /* \"All Approval Status\" dropdown */\r\n\r\n    /* Transfer Result main table (payment/internal-transfer/transfer-result)\r\n       — Figma 1:11730. Row shape mirrors Scheduled Transfer (file-level batch)\r\n       but the per-row \"Transfer Status\" column also renders inline success /\r\n       failed counters and the trailing column is a compact download icon.\r\n       Column widths follow the header-math rule: header label width at\r\n       text-wb-14/600 + 4px gap + 16px sort glyph + 20px padding. */\r\n    --w-wb-tr-datetime: 120px;          /* Date/Time — body \"30-10-2024\" ≈ 80 */\r\n    --w-wb-tr-filename: 240px;          /* File Name — body up to 36-char filenames */\r\n    --w-wb-tr-txn-count: 175px;         /* No. of Transactions — header is the constraint */\r\n    --w-wb-tr-total: 175px;             /* Total Transfer Amount — header is the constraint */\r\n    --w-wb-tr-status: 220px;            /* Transfer Status + success/failed count pills */\r\n    --w-wb-tr-approval-ref: 165px;      /* Approval Ref — body \"VO_20250908_001\" ≈ 130 */\r\n    --w-wb-tr-approval-title: 220px;    /* Approval Title (wraps to 2 lines) */\r\n    --w-wb-tr-action: 48px;             /* trailing per-row size-4 download glyph */\r\n    --w-wb-tr-table-min: 1363px;        /* sum of column widths */\r\n\r\n    /* Transfer Result detail table (payment/internal-transfer/transfer-result/[id])\r\n       — Figma 1:13476. 11 columns, no pagination, no totals footer.\r\n       All widths follow the header-math rule (header text-wb-14/600 + 4px\r\n       gap + 16px sort glyph + 20px padding). Don't undersize: the regression\r\n       this section exists to prevent is \"Date/Time header collapses to '...e'\r\n       because 130px isn't enough room for the label + sort glyph\". */\r\n    --w-wb-trd-datetime: 140px;         /* Date/Time — body \"25-Mar-2026\" ≈ 95 */\r\n    --w-wb-trd-deposit-bank: 210px;     /* Deposit Bank (two-line: code-name+icon+ccy / account) */\r\n    --w-wb-trd-recipient: 160px;        /* Recipient Name */\r\n    --w-wb-trd-amount: 150px;           /* Transfer Amount — right-aligned numeric */\r\n    --w-wb-trd-remark: 180px;           /* Remarks ⓘ */\r\n    --w-wb-trd-result: 130px;           /* Results badge */\r\n    --w-wb-trd-result-datetime: 170px;  /* Result Date/Time — header is the constraint */\r\n    --w-wb-trd-reporting: 190px;        /* Reporting Account — body \"2001019 - Payables\" ≈ 140 */\r\n    --w-wb-trd-description: 140px;      /* Description */\r\n    --w-wb-trd-document-no: 140px;      /* Document No. */\r\n    --w-wb-trd-banking-id: 200px;       /* Banking Transaction ID + Match button slot */\r\n    --w-wb-trd-table-min: 1810px;       /* sum of column widths */\r\n\r\n    /* Sales e-Invoices table (addon/sales-einvoices) — Figma 9194:6696.\r\n       Columns sized to match the Figma spec (total 1340px). */\r\n    --w-wb-si-datetime: 128px;          /* Date/Time */\r\n    --w-wb-si-invoice-no: 145px;        /* e-invoice No. */\r\n    --w-wb-si-buyer: 372px;             /* Buyer's Name */\r\n    --w-wb-si-currency: 112px;          /* Currency */\r\n    --w-wb-si-total: 134px;             /* Total Amount */\r\n    --w-wb-si-status: 143px;            /* Invoice Status */\r\n    --w-wb-si-tax: 121px;               /* Tax Amount */\r\n    --w-wb-si-pretax: 185px;            /* Amount Before Tax */\r\n    --w-wb-si-table-min: 1340px;        /* sum of column widths */\r\n    --w-wb-si-status-filter: 168px;     /* \"All Invoice Status\" dropdown */\r\n\r\n    /* Card Transactions table (payment/corporate-card) — Figma 45:18250.\r\n       11 columns: checkbox, date/time, card number, merchant, card nickname,\r\n       cardholder, amount, reporting account, link reference, approval ref, note. */\r\n    --w-wb-ct-checkbox: 50px;\r\n    --w-wb-ct-datetime: 120px;\r\n    --w-wb-ct-card-number: 175px;\r\n    --w-wb-ct-merchant: 175px;\r\n    --w-wb-ct-nickname: 140px;\r\n    --w-wb-ct-cardholder: 130px;\r\n    --w-wb-ct-amount: 130px;\r\n    --w-wb-ct-reporting: 210px;\r\n    --w-wb-ct-link-ref: 190px;\r\n    --w-wb-ct-approval-ref: 155px;\r\n    --w-wb-ct-note: 46px;\r\n    --w-wb-ct-table-min: 1521px;        /* sum of column widths */\r\n    --w-wb-ct-company-filter: 168px;    /* \"All Card Companies\" dropdown */\r\n    --w-wb-ct-card-filter: 120px;       /* \"All Cards\" dropdown */\r\n\r\n    /* Exchange Rate Inquiry table — Figma 38:13376. Currency-matrix layout:\r\n       one row per currency, one column per bank rate type (Cash Buy/Sell,\r\n       T/T Buy/Sell). Two-line header (bank name / rate type). Row height 48 px,\r\n       header 56 px. Widths follow header-math (text-wb-14/600 + sort + padding). */\r\n    --w-wb-er-currency: 156px;  /* Currency col — flag (28 px) + code + padding */\r\n    --w-wb-er-rate: 236px;      /* Per bank-rate col (Cash Buy/Sell, T/T Buy/Sell) */\r\n    /* NOTE: ExchangeRateInquiryPage uses w-full (no min-w) so the table fills the\r\n       content area exactly (≈ 1099 px at the 1358 px Figma viewport after subtracting\r\n       the 211 px sidebar and 2×24 px page padding). A min-w of 1100 px is 1 px wider\r\n       than the available area and causes a spurious horizontal scrollbar. */\r\n\r\n    /* Settings popup modal (shared across Purpose / VAS Account / Contacts …)\r\n       Sized to match the legacy WeCMS popup (dev.wecms.vn/trns_0001_001.act)\r\n       so users see the same chrome when we switch systems. Figma 9196:11717\r\n       is 1116×736; the live system is 1300×760 and that's the canonical size.\r\n       Sidebar width matches legacy `#left-menu-wrap.setting { width: 210px }` —\r\n       a wider sidebar here shifted the content column 66px right and was the\r\n       main visual mismatch vs the live popup. */\r\n    --w-wb-settings-card: 1300px;       /* modal card fixed width */\r\n    --w-wb-settings-card-h: 760px;      /* modal card fixed height */\r\n    --w-wb-settings-nav: 211px;         /* Figma node 9198:12533 — 211 × 768, expanded */\r\n    --w-wb-settings-nav-collapsed: 65px; /* Figma 9601:23161 — 65 × 768, collapsed icons-only rail */\r\n    --w-wb-settings-col-code: 160px;    /* table col: Purpose Code */\r\n    --w-wb-settings-col-account: 220px; /* table col: Purpose/Account */\r\n    --w-wb-settings-col-description: auto; /* description flexes */\r\n    --w-wb-settings-col-toggle: 80px;   /* table col: Toggle switch */\r\n    /* Bank Account panel — Figma 142:18741. Widths sized for the longest\r\n       header label rendered at text-wb-13/600 + 16px sort glyph + 20px\r\n       padding, tested against the static mock rows. Total = 1620px so the\r\n       table reliably scrolls horizontally inside the modal content area. */\r\n    --w-wb-bank-acct-col-account: 200px;\r\n    --w-wb-bank-acct-col-nickname: 160px;\r\n    --w-wb-bank-acct-col-description: 200px;\r\n    --w-wb-bank-acct-col-type: 130px;\r\n    --w-wb-bank-acct-col-maturity: 130px;\r\n    --w-wb-bank-acct-col-vas-code: 100px;\r\n    --w-wb-bank-acct-col-vas-name: 160px;\r\n    --w-wb-bank-acct-col-view-perm: 140px;\r\n    --w-wb-bank-acct-col-withdraw-perm: 160px;\r\n    --w-wb-bank-acct-col-audit: 180px;\r\n    --w-wb-bank-acct-table-min: 1620px;\r\n    /* Login Credentials table — Figma 999:21715. Institution + Type + Login\r\n       ID/PW + Action are fixed; Audit Logs takes the remaining flex width.\r\n       Min sums to 760px so the table fits the modal content area at 1300px\r\n       card width with no horizontal scroll, and degrades gracefully via the\r\n       shared scroll container on narrower viewports. */\r\n    --w-wb-login-creds-col-institution: 140px;\r\n    --w-wb-login-creds-col-type: 200px;\r\n    --w-wb-login-creds-col-login: 220px;\r\n    --w-wb-login-creds-col-action: 56px;\r\n    --w-wb-login-creds-table-min: 760px;\r\n    --size-wb-icon-sm: 18px;            /* tight Figma icon (checkbox, bank building) */\r\n    --w-wb-logo-wordmark: 72.436px;     /* \"WeCMS\" wordmark SVG */\r\n    --w-wb-login-panel: 420px;          /* login form max-width */\r\n    --w-wb-login-logo: 219px;           /* login page logo width */\r\n    --h-wb-header: 48px;                /* top nav bar */\r\n    --h-wb-table-head: 40px;\r\n    --h-wb-table-row: 60px;\r\n    --h-wb-filter-btn: 32px;            /* filter row / pagination btn height */\r\n}\r\n\r\n@layer base {\r\n    * {\r\n        @apply border-border outline-ring/50;\r\n    }\r\n    html,\r\n    body {\r\n        height: 100%;\r\n    }\r\n    body {\r\n        @apply bg-background text-foreground;\r\n        min-height: 100%;\r\n        font-family: var(--font-sans);\r\n    }\r\n}\r\n\r\n/* ─────────────────────────────────────────────────────────────\r\n   Custom scrollbar — Figma WB365 (nodes 9184:17484 / 9184:10787).\r\n   Scoped classes so only the components that opt in get the\r\n   WeCMS look; the rest of the page keeps the native scrollbar.\r\n   Track: 6px, #fafafa with 0.5px #e5e5e5 border.\r\n   Thumb: #a3a3a3 (fg-disabled); darkens slightly on hover.\r\n   ───────────────────────────────────────────────────────────── */\r\n.custom-scrollbar,\r\n.custom-scrollbar-x,\r\n.custom-scrollbar-y {\r\n    scrollbar-width: thin;\r\n    scrollbar-color: #a3a3a3 #fafafa;\r\n}\r\n\r\n.custom-scrollbar::-webkit-scrollbar,\r\n.custom-scrollbar-x::-webkit-scrollbar,\r\n.custom-scrollbar-y::-webkit-scrollbar {\r\n    width: 6px;\r\n    height: 6px;\r\n}\r\n\r\n/* Hide the start/end step arrows. Figma shows only track + thumb.\r\n   NB: Next.js (Lightning CSS) strips `display: none !important` from\r\n   these pseudo rules as an optimisation — verified by grepping the\r\n   compiled CSS. Workaround: a `display: none` **without** !important\r\n   survives (optimiser keeps the last declaration), and we still layer\r\n   zero-size/appearance overrides on top as defence in depth. */\r\n.custom-scrollbar::-webkit-scrollbar-button,\r\n.custom-scrollbar-x::-webkit-scrollbar-button,\r\n.custom-scrollbar-y::-webkit-scrollbar-button,\r\n.custom-scrollbar::-webkit-scrollbar-button:single-button,\r\n.custom-scrollbar-x::-webkit-scrollbar-button:single-button,\r\n.custom-scrollbar-y::-webkit-scrollbar-button:single-button,\r\n.custom-scrollbar::-webkit-scrollbar-button:double-button,\r\n.custom-scrollbar-x::-webkit-scrollbar-button:double-button,\r\n.custom-scrollbar-y::-webkit-scrollbar-button:double-button,\r\n.custom-scrollbar::-webkit-scrollbar-button:start:decrement,\r\n.custom-scrollbar-x::-webkit-scrollbar-button:start:decrement,\r\n.custom-scrollbar-y::-webkit-scrollbar-button:start:decrement,\r\n.custom-scrollbar::-webkit-scrollbar-button:end:increment,\r\n.custom-scrollbar-x::-webkit-scrollbar-button:end:increment,\r\n.custom-scrollbar-y::-webkit-scrollbar-button:end:increment,\r\n.custom-scrollbar::-webkit-scrollbar-button:horizontal:increment,\r\n.custom-scrollbar-x::-webkit-scrollbar-button:horizontal:increment,\r\n.custom-scrollbar::-webkit-scrollbar-button:horizontal:decrement,\r\n.custom-scrollbar-x::-webkit-scrollbar-button:horizontal:decrement,\r\n.custom-scrollbar::-webkit-scrollbar-button:vertical:increment,\r\n.custom-scrollbar-y::-webkit-scrollbar-button:vertical:increment,\r\n.custom-scrollbar::-webkit-scrollbar-button:vertical:decrement,\r\n.custom-scrollbar-y::-webkit-scrollbar-button:vertical:decrement {\r\n    width: 0 !important;\r\n    height: 0 !important;\r\n    min-width: 0 !important;\r\n    min-height: 0 !important;\r\n    max-width: 0 !important;\r\n    max-height: 0 !important;\r\n    background: transparent !important;\r\n    background-image: none !important;\r\n    background-color: transparent !important;\r\n    border: 0 none !important;\r\n    visibility: hidden !important;\r\n    -webkit-appearance: none !important;\r\n    appearance: none !important;\r\n    display: none;\r\n}\r\n\r\n.custom-scrollbar::-webkit-scrollbar-track,\r\n.custom-scrollbar-x::-webkit-scrollbar-track,\r\n.custom-scrollbar-y::-webkit-scrollbar-track {\r\n    background: #fafafa;\r\n    box-shadow: inset 0 0 0 0.5px #e5e5e5;\r\n}\r\n\r\n.custom-scrollbar::-webkit-scrollbar-thumb,\r\n.custom-scrollbar-x::-webkit-scrollbar-thumb,\r\n.custom-scrollbar-y::-webkit-scrollbar-thumb {\r\n    background: #a3a3a3;\r\n    border-radius: 0;\r\n}\r\n\r\n.custom-scrollbar::-webkit-scrollbar-thumb:hover,\r\n.custom-scrollbar-x::-webkit-scrollbar-thumb:hover,\r\n.custom-scrollbar-y::-webkit-scrollbar-thumb:hover {\r\n    background: #737373;\r\n}\r\n\r\n.custom-scrollbar::-webkit-scrollbar-corner,\r\n.custom-scrollbar-x::-webkit-scrollbar-corner,\r\n.custom-scrollbar-y::-webkit-scrollbar-corner {\r\n    background: #fafafa;\r\n}\r\n\r\n/* App-wide arrow-button suppressor. The `.custom-scrollbar` rules above\r\n   already hide buttons inside opted-in containers, but Windows' default\r\n   Chromium scrollbar still renders the up/down step arrows on any\r\n   element that doesn't carry the class (page body, plain `overflow:auto`\r\n   children, etc.). This zero-specificity rule strips them everywhere\r\n   without touching scrollbar size, thumb, or scroll behaviour — it\r\n   simply blanks the `::-webkit-scrollbar-button` pseudo at the\r\n   document root so the WeCMS look stays consistent across every\r\n   scrollable surface. `display: none` is intentionally written without\r\n   `!important` (Lightning CSS strips that, see the comment above). */\r\n::-webkit-scrollbar-button {\r\n    width: 0;\r\n    height: 0;\r\n    display: none;\r\n}\r\n\r\n/* Axis-scoped variants suppress the unused axis entirely so a vertical-only\r\n   scroll container never shows a ghost horizontal track (and vice versa). */\r\n.custom-scrollbar-y::-webkit-scrollbar:horizontal {\r\n    height: 0;\r\n}\r\n.custom-scrollbar-x::-webkit-scrollbar:vertical {\r\n    width: 0;\r\n}\r\n

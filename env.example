# =============================================================================
#  wecms-web-main — local environment variables (template)
# =============================================================================
#  Rename this file to `.env.example` (with leading dot), commit it. Then
#  copy `.env.example` to `.env` (or `.env.local`) and fill in real values
#  — `.env*` is git-ignored except `.env.example`.
#
#  Next.js auto-loads (priority order):
#      .env.local  >  .env.development  >  .env
#
#  Restart `npm run dev` after changing values — Next.js reads .env files
#  only at process start.
#
#  Only variables prefixed with `NEXT_PUBLIC_` are inlined into the browser
#  bundle at BUILD time. Unprefixed variables stay server-side (used by
#  route handlers and `proxy.ts` middleware).
#
#  WARNING: `NEXT_PUBLIC_*` values bake into `npm run build` output. After
#  changing any of them you MUST rebuild + redeploy — a reload of an
#  existing deployment does NOT pick up new values.
# =============================================================================


# === WeCMS Backend API ===
# Base URL of the Spring Boot API the frontend talks to.
#
# Environments:
#   Local dev backend           -> http://localhost:8080
#   SIT (deployed)              -> https://wecms-api.kosign.dev
#   Office DEV (legacy JEX)     -> https://dev.wecms.vn
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080


# === WeCMS API (reserved — not yet wired in code) ===
# Reserved placeholder for an additional WeCMS service endpoint.
# Fill in once the second WeCMS endpoint is defined.
NEXT_PUBLIC_WECMS_API_URL=


# === NextAuth (reserved — NextAuth.js is NOT currently used) ===
# The project uses a plain Axios login + JWT today (see lib/auth/client.ts).
# CLAUDE.md §"Tech Stack" explicitly forbids adding NextAuth without a
# written reason. Keys reserved below so a future migration can drop
# them in without renaming env vars.
#
# NEXTAUTH_URL    — absolute URL of the deployed site, e.g. https://wecms.kosign.dev
# NEXTAUTH_SECRET — 32+ char signing secret; generate with: openssl rand -hex 32
NEXTAUTH_URL=
NEXTAUTH_SECRET=

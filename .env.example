# =============================================================================
# API
# Backend API origin the browser calls (we-scraping-api). Inlined at build time.
# Locally the backend must allow this app's origin:
#   WECMS_CORS_ALLOWED_ORIGINS=http://localhost:3000   (backend .env)
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# =============================================================================
# WeInvoice data source
#   mock (default) — in-memory demo data, no backend needed for screens
#   api            — P1 screens read /api/v1/weinvoice/* (published contract), store
#                    starts empty; P3–P6 screens stay mock
# =============================================================================
NEXT_PUBLIC_WEINVOICE_DATA_SOURCE=mock

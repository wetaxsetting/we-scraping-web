# wecms-web env template. Copy to .env.local; deploy sets values via CI env.
# NEXT_PUBLIC_* is inlined at build time — set it before `next build` / `next dev`.

# Backend API origin the browser calls (Axios baseURL). A deployed frontend MUST
# set this; when unset it falls back to http://localhost:8080 (local dev only).
#   Local  http://localhost:3000     -> http://localhost:8080
#   SIT    https://wecms.kosign.dev  -> https://wecms-api.kosign.dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional NXiSAS scraping debug logs. true | false (default false).
NEXT_PUBLIC_NXISAS_DEBUG=false
